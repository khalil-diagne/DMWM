# Base de données Neon (Postgres serverless)
# Renseigner la chaîne de connexion fournie par Neon dans le Marketplace Vercel
DATABASE_URL=

# Secret JWT pour signer les jetons d'authentification (générer une valeur longue)
JWT_SECRET=

# Compte admin initial créé par `npm run db:seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrateur du dahira
